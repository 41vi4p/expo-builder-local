# Maintainer: 41vi4p <https://github.com/41vi4p>
#
# Builds the `ebl` CLI from source against the distro's own curl/openssl, so there's
# no prebuilt-binary ABI mismatch risk the way there would be shipping the .deb's
# ubuntu:24.04-linked binary here (see ../../cli/CMakeLists.txt and
# ../../docs/RELEASING.md). Not (yet) published to the AUR — see
# ../../CLAUDE.md#-version-management for why pkgver here is bumped by hand in step
# with the other four version fields, and ../../docs/RELEASING.md for the sha256sums
# note below. Usable right now either via `makepkg -si` directly in this directory,
# or through install.sh's Arch-detection path, which fetches this same file.
#
# Remember to regenerate .SRCINFO (`makepkg --printsrcinfo > .SRCINFO`) any time
# this file changes.
pkgname=ebl
pkgver=0.16.0
pkgrel=1
pkgdesc="Build managed Expo projects into signed Android APK/AABs in a disposable Docker container"
# Matches every other release artifact in this repo (CI, the .deb, the Windows
# build) — all x86_64-only for now (see install.sh's own uname -m check).
arch=('x86_64')
url="https://github.com/41vi4p/expo-builder-local"
license=('GPL3')
depends=('curl' 'openssl')
makedepends=('cmake')
optdepends=('docker: required at runtime to actually run builds')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# Real checksum of the tag archive, computed by hand after tagging (there's no
# per-release AUR-publishing step to do it automatically yet — see
# ../../docs/RELEASING.md). Reset to SKIP here because pkgver just moved to
# 0.14.1 and that tag doesn't exist yet — recompute once it's tagged/released,
# following ../../docs/RELEASING.md's "Arch Linux packaging" section. If this step
# ever gets missed for an actual release, leave it as SKIP rather than ship a
# stale/wrong checksum, which would make makepkg refuse to build entirely.
sha256sums=('SKIP')

build() {
  cd "expo-builder-local-$pkgver/cli"
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  cd "expo-builder-local-$pkgver/cli"
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 ../LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
